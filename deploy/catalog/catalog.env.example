# /etc/runpod-catalog/catalog.env  (root:root, mode 0600)
#
# Template only: copy to /etc/runpod-catalog/catalog.env and fill in on the
# server. NEVER commit a filled copy. The only secret here is
# CATALOG_ADMIN_PASSWORD_HASH (a scrypt hash, never the plaintext password).
#
# Names and semantics are those of catalog_service/config.py — no aliases.
# systemd reads EnvironmentFile= as root before dropping privileges, so the file
# stays 0600 root:root even though the service runs as runpod-catalog.

# --- required by config.py ----------------------------------------------------
# Exact same origin the browser uses. Scheme + host[:port] only, no path.
# Requests' Host / X-Forwarded-Host headers are never trusted.
CATALOG_PUBLIC_ORIGIN=https://runpod.hyxer.top
# SQLite path. Must stay outside every app version directory.
CATALOG_DB_PATH=/var/lib/runpod-catalog/catalog.db
# Output of `python -m catalog_service.cli init-admin` (interactive, scrypt$).
# Placeholder: replace via the runbook; login returns 503 while unset/malformed.
CATALOG_ADMIN_PASSWORD_HASH=scrypt$16384$8$1$REPLACE_WITH_INIT_ADMIN_OUTPUT

# --- optional, defaults shown ------------------------------------------------
# Production keeps Secure cookies (true). Only local HTTP debugging sets false.
CATALOG_COOKIE_SECURE=true
# Loopback listener; python -m catalog_service refuses non-loopback hosts.
CATALOG_HOST=127.0.0.1
CATALOG_PORT=8787
